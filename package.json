{
  "name": "@listeningkit/log",
  "version": "0.1.4",
  "description": "ListeningKit's go-to-market tool, open-sourced: one CLI and MCP server that runs your accounts on X, Reddit, Facebook and Discord, self-hosted.",
  "type": "module",
  "bin": {
    "log": "bin/log.ts",
    "logMcp": "bin/logMcp.ts"
  },
  "files": [
    "bin",
    "src",
    "python",
    "vendor",
    "scripts",
    "docs",
    "skills",
    "skills.md",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    ".env.example",
    "tsconfig.json",
    "bunfig.toml",
    "!**/*.test.ts",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "engines": {
    "node": "24.x",
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewdonsemail-lab/log.git"
  },
  "homepage": "https://log.listeningkit.com",
  "bugs": {
    "url": "https://github.com/matthewdonsemail-lab/log/issues"
  },
  "keywords": [
    "cli",
    "mcp",
    "social-listening",
    "twitter",
    "reddit",
    "facebook",
    "discord",
    "go-to-market",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run bin/log.ts",
    "launch": "bun run bin/log.ts launch",
    "doctor": "bun run bin/log.ts doctor",
    "mcp": "bun run bin/logMcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:naming": "node scripts/checks/checkNamingConventions.mjs",
    "check:facebookClientDocs": "node scripts/checks/checkFacebookClientDocs.mjs",
    "check:browsers": "bun scripts/checks/checkBrowserParity.ts",
    "check:agentHooks": "bun scripts/checks/checkAgentHooks.ts",
    "check:layout": "bun scripts/checks/checkLayout.ts",
    "check:oneDatabase": "bun scripts/checks/checkOneDatabase.ts",
    "check:noComments": "bun scripts/checks/checkNoComments.ts",
    "check:twikitTransport": "bun scripts/checks/checkTwikitTransport.ts",
    "check:linkedinTransport": "bun scripts/checks/checkLinkedinTransport.ts",
    "check:slackTransport": "bun scripts/checks/checkSlackTransport.ts",
    "check:instagramTransport": "bun scripts/checks/checkInstagramTransport.ts",
    "check:platforms": "bun scripts/checks/checkPlatforms.ts",
    "docs:build": "bun scripts/docs/buildDocs.ts",
    "check:useCases": "bun scripts/checks/checkUseCases.ts",
    "check:docs": "bun scripts/docs/buildDocs.ts --check",
    "browsers:docs": "bun scripts/checks/checkBrowserParity.ts --write",
    "errors:export": "bun bin/log.ts errors --json > python/errors/errorCatalog.json && bun bin/log.ts errors --markdown > docs/errorCatalog.md",
    "check": "bun run check:noComments && bun run check:twikitTransport && bun run check:reverseChudTransport && bun run check:linkedinTransport && bun run check:slackTransport && bun run check:instagramTransport && bun run check:platforms && bun run check:naming && bun run check:layout && bun run check:oneDatabase && bun run check:browsers && bun run check:agentHooks && bun run check:docs && bun run check:siteDocs && bun run check:siteSkills && bun run check:specs && bun run typecheck && bun run test",
    "prepare": "bun scripts/git/installHooks.ts",
    "twenty:client": "node scripts/twenty/emitTwentyClient.mjs",
    "twenty:client:check": "node scripts/twenty/emitTwentyClient.mjs --check",
    "check:siteDocs": "node scripts/docs/syncSiteDocs.mjs --check",
    "skills:build": "node scripts/docs/syncSiteSkills.mjs",
    "check:siteSkills": "node scripts/docs/syncSiteSkills.mjs --check",
    "check:specs": "bun scripts/checks/checkSpecs.ts",
    "check:reverseChudTransport": "bun scripts/checks/checkReverseChudTransport.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bm25s": "2.0.0",
    "cheerio": "1.2.0",
    "sharp": "^0.34.5",
    "verso-db": "0.8.1",
    "wreq-js": "3.0.0",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "graphql": "^16",
    "jev-spec": "0.4.1",
    "jsdom": "25.0.1",
    "lefthook": "^2.2.2",
    "mermaid": "11.4.1",
    "ts-morph": "^28.0.0",
    "twenty-client-sdk": "^2.43.0",
    "typescript": "^5.9.3"
  },
  "author": "matthewdonsemail-lab",
  "license": "MIT",
  "trustedDependencies": [
    "onnxruntime-node"
  ],
  "patchedDependencies": {
    "jev-spec@0.4.1": "patches/jev-spec@0.4.1.patch"
  }
}
