{
  "name": "log-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bun CLI for the ListeningKit log Facebook Marketplace data: listings, their accounts, and the listing state machine.",
  "bin": {
    "log": "./bin/log.ts"
  },
  "scripts": {
    "start": "bun run bin/log.ts",
    "launch": "bun run bin/log.ts launch",
    "doctor": "bun run bin/log.ts doctor",
    "mcp": "bun run bin/logMcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:naming": "node scripts/checkNamingConventions.mjs",
    "check:facebookClientDocs": "node scripts/checkFacebookClientDocs.mjs",
    "errors:export": "bun bin/log.ts errors --json > python/errorCatalog.json && bun bin/log.ts errors --markdown > docs/errorCatalog.md",
    "check": "bun run check:naming && bun run typecheck && bun run test",
    "prepare": "git config --unset core.hooksPath; lefthook install",
    "twenty:client": "node scripts/emitTwentyClient.mjs",
    "twenty:client:check": "node scripts/emitTwentyClient.mjs --check"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.34.5",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "graphql": "^16",
    "lefthook": "^2.2.2",
    "twenty-client-sdk": "^2.43.0",
    "typescript": "^5.9.3"
  },
  "author": "matthewdonsemail-lab",
  "license": "MIT"
}
