{
  "name": "log-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bun CLI for the ListeningKit log Facebook Marketplace data: listings, their accounts, and the listing state machine.",
  "bin": {
    "log": "./bin/log.ts"
  },
  "scripts": {
    "start": "bun run bin/log.ts",
    "launch": "bun run bin/log.ts launch",
    "doctor": "bun run bin/log.ts doctor",
    "mcp": "bun run bin/logMcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:naming": "node scripts/checks/checkNamingConventions.mjs",
    "check:facebookClientDocs": "node scripts/checks/checkFacebookClientDocs.mjs",
    "check:browsers": "bun scripts/checks/checkBrowserParity.ts",
    "check:agentHooks": "bun scripts/checks/checkAgentHooks.ts",
    "check:layout": "bun scripts/checks/checkLayout.ts",
    "check:noComments": "bun scripts/checks/checkNoComments.ts",
    "check:twikitTransport": "bun scripts/checks/checkTwikitTransport.ts",
    "check:platforms": "bun scripts/checks/checkPlatforms.ts",
    "docs:build": "bun scripts/docs/buildDocs.ts",
    "check:docs": "bun scripts/docs/buildDocs.ts --check",
    "browsers:docs": "bun scripts/checks/checkBrowserParity.ts --write",
    "errors:export": "bun bin/log.ts errors --json > python/errors/errorCatalog.json && bun bin/log.ts errors --markdown > docs/errorCatalog.md",
    "check": "bun run check:noComments && bun run check:twikitTransport && bun run check:platforms && bun run check:naming && bun run check:layout && bun run check:browsers && bun run check:agentHooks && bun run check:docs && bun run typecheck && bun run test",
    "prepare": "git config --unset core.hooksPath; lefthook install",
    "twenty:client": "node scripts/twenty/emitTwentyClient.mjs",
    "twenty:client:check": "node scripts/twenty/emitTwentyClient.mjs --check"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.34.5",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "graphql": "^16",
    "jsdom": "25.0.1",
    "lefthook": "^2.2.2",
    "mermaid": "11.4.1",
    "twenty-client-sdk": "^2.43.0",
    "typescript": "^5.9.3"
  },
  "author": "matthewdonsemail-lab",
  "license": "MIT"
}
