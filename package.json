{
  "name": "listeningkit-hackathon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ListeningKit hackathon monorepo — Vite + React + TS apps with shared UI package (matches open-offer-builder / Open-Cold-Dialer / ui-kit stack).",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "concurrently -n web,docs -c blue,green \"pnpm --filter web dev\" \"pnpm --filter docs dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && oxlint convex",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:backend",
    "typecheck:backend": "tsc -p convex/tsconfig.json",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "preview": "pnpm --filter web preview",
    "start": "concurrently -n web,docs -c blue,green \"pnpm --filter web preview\" \"pnpm --filter docs start\""
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@types/node": "^22",
    "concurrently": "^9.1.0",
    "convex-test": "^0.0.58",
    "lefthook": "^2.1.12",
    "oxlint": "^1.83.0",
    "typescript": "~5.6.2",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "fumadocs-ui": "15.7.8",
      "fumadocs-core": "15.7.8"
    }
  },
  "dependencies": {
    "convex": "^1.45.0"
  }
}
