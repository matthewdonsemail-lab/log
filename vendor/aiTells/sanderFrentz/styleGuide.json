{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "name": "corporate-ai-style-guide",
  "version": "1.0.0",
  "description": "A drop-in style guide that tells an LLM which AI-tell words, phrases, and structural patterns to avoid in corporate documents, plus plain professional alternatives. Pass the contents of this file in the system prompt or user message.",
  "instructions_for_llm": [
    "Treat every entry under `avoid_words` and `avoid_phrases` as banned in your output.",
    "When a banned term fits the meaning, pick the closest item from its `alternatives`. If none fit, rewrite the sentence in plain language instead of substituting another fancy word.",
    "Do not replace a banned word with a synonym that is also on the list.",
    "Do not produce any structure listed in `avoid_patterns`.",
    "Do not open replies with any phrase in `avoid_openers` or close with any phrase in `avoid_closers`.",
    "Prefer concrete nouns and specific verbs over abstract, evocative ones. If you cannot say something concretely, cut it.",
    "Write in the user's voice, not a marketing voice. No hype, no sweeping claims, no inspirational framing unless the user explicitly asks for it."
  ],

  "avoid_words": {
    "delve": { "alternatives": ["examine", "look at", "study", "go through"], "category": "verb" },
    "dive": { "alternatives": ["look at", "examine", "go through"], "category": "verb", "note": "Especially 'dive into' and 'dive deep'." },
    "embark": { "alternatives": ["start", "begin"], "category": "verb" },
    "unveil": { "alternatives": ["show", "release", "present", "announce"], "category": "verb" },
    "unleash": { "alternatives": ["release", "enable", "allow"], "category": "verb" },
    "unlock": { "alternatives": ["enable", "open up", "make available"], "category": "verb" },
    "harness": { "alternatives": ["use", "apply"], "category": "verb" },
    "leverage": { "alternatives": ["use", "apply"], "category": "verb", "note": "As a verb. The noun is fine in finance contexts." },
    "utilize": { "alternatives": ["use"], "category": "verb" },
    "foster": { "alternatives": ["build", "encourage", "support", "grow"], "category": "verb" },
    "empower": { "alternatives": ["enable", "equip", "help"], "category": "verb" },
    "elevate": { "alternatives": ["improve", "raise", "lift"], "category": "verb" },
    "navigate": { "alternatives": ["handle", "manage", "work through", "deal with"], "category": "verb", "note": "Especially 'navigate the complexities of'." },
    "streamline": { "alternatives": ["simplify", "speed up", "reduce steps in"], "category": "verb" },
    "optimize": { "alternatives": ["improve", "refine", "tune"], "category": "verb" },
    "transcend": { "alternatives": ["go beyond", "exceed"], "category": "verb" },
    "strive": { "alternatives": ["aim", "try", "work to"], "category": "verb" },
    "weave": { "alternatives": ["combine", "build", "bring together"], "category": "verb" },
    "curate": { "alternatives": ["select", "choose", "pick"], "category": "verb" },
    "craft": { "alternatives": ["write", "build", "make"], "category": "verb" },
    "excel": { "alternatives": ["do well", "perform strongly", "lead"], "category": "verb" },
    "ensure": { "alternatives": ["make sure", "confirm"], "category": "verb", "note": "Fine occasionally; overused as filler." },
    "facilitate": { "alternatives": ["help", "support", "run"], "category": "verb" },

    "realm": { "alternatives": ["field", "area", "industry"], "category": "noun" },
    "landscape": { "alternatives": ["field", "industry", "market", "environment"], "category": "noun" },
    "tapestry": { "alternatives": ["mix", "range", "set"], "category": "noun" },
    "testament": { "alternatives": ["example", "proof", "evidence"], "category": "noun", "note": "Almost always replaceable with 'shows' or 'proves'." },
    "myriad": { "alternatives": ["many", "several", "a range of"], "category": "noun" },
    "plethora": { "alternatives": ["many", "a lot of", "several"], "category": "noun" },
    "journey": { "alternatives": ["process", "path", "work"], "category": "noun", "note": "Especially 'on a journey to', 'embark on a journey'." },
    "ecosystem": { "alternatives": ["set of tools", "network", "stack", "market"], "category": "noun", "note": "Only avoid when used metaphorically." },
    "portrayal": { "alternatives": ["picture", "description", "view"], "category": "noun" },
    "vision": { "alternatives": ["plan", "goal", "aim"], "category": "noun", "note": "Avoid as marketing filler." },

    "intricate": { "alternatives": ["complex", "detailed"], "category": "adjective" },
    "pivotal": { "alternatives": ["key", "central", "important"], "category": "adjective" },
    "crucial": { "alternatives": ["important", "essential", "key"], "category": "adjective" },
    "vital": { "alternatives": ["important", "essential", "key"], "category": "adjective" },
    "robust": { "alternatives": ["strong", "solid", "reliable"], "category": "adjective" },
    "comprehensive": { "alternatives": ["complete", "thorough", "full"], "category": "adjective" },
    "vibrant": { "alternatives": ["active", "lively", "busy"], "category": "adjective" },
    "seamless": { "alternatives": ["smooth", "easy", "with no handoff issues"], "category": "adjective" },
    "compelling": { "alternatives": ["strong", "convincing", "clear"], "category": "adjective" },
    "meticulous": { "alternatives": ["careful", "thorough", "precise"], "category": "adjective" },
    "nuanced": { "alternatives": ["subtle", "specific", "case-by-case"], "category": "adjective" },
    "holistic": { "alternatives": ["complete", "end-to-end", "across the board"], "category": "adjective" },
    "transformative": { "alternatives": ["significant", "major", "substantial"], "category": "adjective" },
    "groundbreaking": { "alternatives": ["new", "novel"], "category": "adjective" },
    "cutting-edge": { "alternatives": ["latest", "current", "new"], "category": "adjective" },
    "state-of-the-art": { "alternatives": ["latest", "current", "modern"], "category": "adjective" },
    "innovative": { "alternatives": ["new", "novel", "different"], "category": "adjective" },
    "dynamic": { "alternatives": ["changing", "flexible", "active"], "category": "adjective" },
    "diverse": { "alternatives": ["varied", "different", "mixed"], "category": "adjective", "note": "Fine in DE&I contexts; avoid as vague filler." },
    "multifaceted": { "alternatives": ["complex", "many-sided", "varied"], "category": "adjective" },
    "vast": { "alternatives": ["large", "broad", "wide"], "category": "adjective" },
    "profound": { "alternatives": ["deep", "significant", "major"], "category": "adjective" },
    "bespoke": { "alternatives": ["custom", "tailored", "specific"], "category": "adjective" },
    "ever-evolving": { "alternatives": ["changing", "developing"], "category": "adjective" },
    "ever-changing": { "alternatives": ["changing", "shifting"], "category": "adjective" },
    "fast-paced": { "alternatives": ["fast", "high-tempo", "busy"], "category": "adjective" },
    "world-class": { "alternatives": ["leading", "top-tier", "expert"], "category": "adjective" },
    "best-in-class": { "alternatives": ["leading", "top"], "category": "adjective" },
    "synergistic": { "alternatives": ["combined", "joint", "shared"], "category": "adjective" },
    "scalable": { "alternatives": ["grows with demand", "handles more load"], "category": "adjective", "note": "Fine in technical contexts; vague as marketing." },
    "actionable": { "alternatives": ["usable", "specific", "concrete"], "category": "adjective" },
    "impactful": { "alternatives": ["meaningful", "useful", "with measurable effect"], "category": "adjective" },

    "strategically": { "alternatives": ["deliberately", "on purpose", "with a plan"], "category": "adverb" },
    "effectively": { "alternatives": ["well", "successfully", "(often: cut entirely)"], "category": "adverb" },
    "consistently": { "alternatives": ["reliably", "regularly", "every time"], "category": "adverb" },
    "significantly": { "alternatives": ["clearly", "by [X amount]", "noticeably"], "category": "adverb" },
    "notably": { "alternatives": ["especially", "in particular"], "category": "adverb" },
    "arguably": { "alternatives": ["possibly", "perhaps", "(often: cut entirely)"], "category": "adverb" },
    "ultimately": { "alternatives": ["in the end", "finally", "(often: cut entirely)"], "category": "adverb" },
    "essentially": { "alternatives": ["basically", "in short", "(often: cut entirely)"], "category": "adverb" },
    "fundamentally": { "alternatives": ["basically", "at heart", "(often: cut entirely)"], "category": "adverb" },
    "truly": { "alternatives": ["genuinely", "(often: cut entirely)"], "category": "adverb" },
    "meticulously": { "alternatives": ["carefully", "thoroughly"], "category": "adverb" },
    "seamlessly": { "alternatives": ["smoothly", "without friction"], "category": "adverb" },

    "additionally": { "alternatives": ["also", "and", "plus"], "category": "transition" },
    "moreover": { "alternatives": ["also", "and"], "category": "transition" },
    "furthermore": { "alternatives": ["also", "and", "besides"], "category": "transition" },
    "however": { "alternatives": ["but", "though", "yet"], "category": "transition", "note": "Fine sparingly; AI tends to chain 'However,...' at the start of paragraphs." },
    "in essence": { "alternatives": ["in short", "basically", "(often: cut entirely)"], "category": "transition" },
    "in conclusion": { "alternatives": ["to wrap up", "in short", "(often: cut entirely; just end)"], "category": "transition" },
    "in summary": { "alternatives": ["to recap", "in short"], "category": "transition" }
  },

  "avoid_phrases": {
    "it's important to note that": { "alternatives": ["(state the point directly)"] },
    "it's worth mentioning that": { "alternatives": ["(state the point directly)"] },
    "it's important to remember that": { "alternatives": ["(state the point directly)"] },
    "it should be noted that": { "alternatives": ["(state the point directly)"] },
    "as we navigate": { "alternatives": ["as we work through", "as we deal with"] },
    "in today's fast-paced world": { "alternatives": ["today", "(cut entirely)"] },
    "in an era where": { "alternatives": ["today", "currently"] },
    "in the ever-evolving landscape of": { "alternatives": ["in [field]", "in [industry] today"] },
    "in the realm of": { "alternatives": ["in", "in [field]"] },
    "in the world of": { "alternatives": ["in", "in [field]"] },
    "delve into": { "alternatives": ["look at", "examine", "go through"] },
    "dive into": { "alternatives": ["look at", "start on", "go through"] },
    "dive deep into": { "alternatives": ["examine in detail", "study closely"] },
    "embark on a journey": { "alternatives": ["start", "begin"] },
    "unlock the potential of": { "alternatives": ["enable", "make use of", "get value from"] },
    "tapestry of": { "alternatives": ["mix of", "range of", "set of"] },
    "a testament to": { "alternatives": ["proof of", "shows", "demonstrates"] },
    "navigating the complexities of": { "alternatives": ["handling", "managing", "working through"] },
    "navigating the intricacies of": { "alternatives": ["handling the details of", "working through"] },
    "push the boundaries of": { "alternatives": ["advance", "extend"] },
    "break new ground": { "alternatives": ["do something new", "advance the field"] },
    "pave the way for": { "alternatives": ["enable", "lead to", "set up"] },
    "at the forefront of": { "alternatives": ["leading in", "among the leaders in"] },
    "stand the test of time": { "alternatives": ["last", "hold up"] },
    "game-changer": { "alternatives": ["major shift", "significant change", "(be specific about the change)"] },
    "needle-moving": { "alternatives": ["high-impact", "(quantify the effect)"] },
    "low-hanging fruit": { "alternatives": ["easy wins", "the simplest items first"] },
    "circle back": { "alternatives": ["follow up", "revisit"] },
    "touch base": { "alternatives": ["check in", "speak"] },
    "moving forward": { "alternatives": ["from now on", "going forward", "(cut entirely)"] },
    "at the end of the day": { "alternatives": ["in the end", "(cut entirely)"] },
    "synergy": { "alternatives": ["combined effect", "joint work"] },
    "best practices": { "alternatives": ["proven methods", "what works", "(name them specifically)"] },
    "thought leadership": { "alternatives": ["industry commentary", "expert writing"] },
    "deep dive": { "alternatives": ["detailed review", "close look"] },
    "deep understanding": { "alternatives": ["solid grasp", "working knowledge"] },
    "let's explore": { "alternatives": ["here is", "consider", "(cut entirely)"] },
    "let's take a closer look at": { "alternatives": ["(just present the content)"] },
    "without further ado": { "alternatives": ["(cut entirely)"] },
    "hopefully this helps": { "alternatives": ["(end without it)"] },
    "feel free to": { "alternatives": ["please", "you can"] },
    "i'd be happy to": { "alternatives": ["(just do the thing)"] },
    "great question": { "alternatives": ["(cut entirely and answer)"] },
    "certainly! here's": { "alternatives": ["(just provide the answer)"] },
    "as an ai language model": { "alternatives": ["(state the limitation plainly without referring to AI identity)"] },
    "as of my last knowledge update": { "alternatives": ["(state the date or scope of what you know plainly)"] },
    "i hope this helps": { "alternatives": ["(end without it)"] },
    "in this article we will explore": { "alternatives": ["this covers", "(just start with the content)"] },
    "whether you're a beginner or an expert": { "alternatives": ["(address one audience directly, or none)"] },
    "the world of": { "alternatives": ["in [field]"] },
    "in the heart of": { "alternatives": ["in", "at the center of"] }
  },

  "avoid_openers": [
    "Certainly!",
    "Of course!",
    "Absolutely!",
    "Great question!",
    "That's a great question.",
    "I'd be happy to help with that.",
    "Sure! Here's...",
    "Here's a comprehensive...",
    "In today's...",
    "In the ever-evolving...",
    "Navigating the..."
  ],

  "avoid_closers": [
    "I hope this helps!",
    "Hopefully this helps!",
    "Let me know if you have any other questions.",
    "Feel free to ask if you need anything else.",
    "In conclusion, ...",
    "Ultimately, ...",
    "At the end of the day, ..."
  ],

  "avoid_patterns": [
    {
      "name": "It's not X, it's Y",
      "description": "Repeated antithetical sentence pairs that try to feel profound, e.g. 'It's not a rant. It's a reflection.'",
      "fix": "State Y directly. Use the pattern at most once per document, and only when the contrast is real."
    },
    {
      "name": "Rhetorical question + short answer",
      "description": "'The kicker? It's this. The best part? It's that.'",
      "fix": "State the point in a declarative sentence."
    },
    {
      "name": "Tricolon of parallel clauses",
      "description": "Three-part parallel structures stacked throughout the text, e.g. 'It's clear. It's concise. It's compelling.'",
      "fix": "Vary sentence structure. Use a tricolon at most once for emphasis."
    },
    {
      "name": "Excessive bolding of buzzwords",
      "description": "Bolding two or more phrases per paragraph to add emphasis.",
      "fix": "Bold at most one phrase per paragraph, and only when a reader scanning needs that exact phrase to find the point."
    },
    {
      "name": "Heavy signposting",
      "description": "'Here's the key takeaway...', 'The most important thing is...', 'Here's what most people miss...'",
      "fix": "Just deliver the takeaway as a normal sentence."
    },
    {
      "name": "Comprehensive list-of-everything",
      "description": "Lists that cover every angle equally instead of taking a position.",
      "fix": "Pick the two or three items that actually matter and say why."
    },
    {
      "name": "Marketing tricolon openings",
      "description": "Opening sections with three adjectives, e.g. 'fast, reliable, and scalable'.",
      "fix": "Pick one specific claim and back it with a number or example."
    },
    {
      "name": "Em-dash overuse",
      "description": "More than one em-dash per paragraph, or em-dashes used in place of commas, parentheses, and colons interchangeably.",
      "fix": "Use commas, parentheses, or a new sentence. Reserve em-dashes for one genuine aside per page."
    },
    {
      "name": "Hedging stack",
      "description": "Multiple hedges in one sentence, e.g. 'It could arguably be considered somewhat important.'",
      "fix": "Pick one position. Hedge once, or not at all."
    },
    {
      "name": "Empty intro paragraph",
      "description": "Opening with a restatement of the prompt or a vague scene-setter before any content.",
      "fix": "Lead with the answer or the most important fact."
    }
  ],

  "general_rules": [
    "Default to short sentences with concrete subjects and verbs.",
    "If a sentence can be cut without losing meaning, cut it.",
    "Replace abstract value claims ('robust', 'impactful') with a number, an example, or a specific outcome.",
    "Use the same word twice instead of reaching for a synonym to look varied.",
    "Match the register of internal corporate writing: plain, direct, low-adjective. No essay flourish."
  ]
}
