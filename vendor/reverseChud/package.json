{
  "name": "reversechud",
  "version": "0.1.0",
  "description": "A headless TypeScript SDK for Reddit's web API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --sourcemap=external --packages external",
    "build:types": "tsc --emitDeclarationOnly",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "reddit",
    "sdk",
    "typescript",
    "bun"
  ],
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "cheerio": "1.2.0",
    "wreq-js": "3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
