{
  "manifest_version": 3,
  "name": "ListeningKit",
  "version": "0.1.0",
  "description": "Extract cookies from Reddit, Twitter and Facebook and store them to use in ListeningKit.",
  "permissions": ["activeTab", "cookies", "clipboardWrite", "storage", "scripting"],
  "host_permissions": [
    "https://*.reddit.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.facebook.com/*"
  ],
  "action": {
    "default_title": "ListeningKit Connect",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
