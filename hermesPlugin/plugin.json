{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "listeningkit-log",
  "version": "0.2.0",
  "description": "Runs your X, Discord, Slack, Instagram and Reddit conversations from Hermes through log by ListeningKit: read inboxes, find what needs a reply, draft it in your own voice and send only after you approve.",
  "author": {
    "name": "ListeningKit",
    "url": "https://github.com/deepmroot"
  },
  "homepage": "https://log.listeningkit.com",
  "repository": "https://github.com/deepmroot/listeningkit-log",
  "license": "MIT",
  "keywords": ["dms", "inbox", "social", "outreach", "x", "twitter", "discord", "slack", "instagram", "reddit", "mcp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "log": { "trust": "untrusted", "timeout": 600 }
      }
    }
  }
}
