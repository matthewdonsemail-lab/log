# log-cli environment. Copy to .env.local (git-ignored; Bun loads it on its
# own) and fill in. Never commit real values.

# ── log-cli ──────────────────────────────────────────────────────────────
# Blaster web app + API for `log login` (defaults are the hosted blaster).
LOG_WEB_URL=
LOG_API_URL=
# Python interpreter for the Camoufox worker (default: python).
LOG_PYTHON=
# Home countries whose accounts hold an AdsPower profile, comma separated
# (e.g. US). Empty: every country. Others give theirs back (rule 78).
LOG_ADSPOWER_HOMES=

# ── Twenty (accounts and listings live there, rules 13 and 14) ──────────
# Your own Twenty server (e.g. http://localhost:3000/rest). There is no default host. LOG_TWENTY_*
# win over TWENTY_*, which blaster still points at the legacy Twenty. Base URL with or without /rest.
LOG_TWENTY_BASE_URL=
LOG_TWENTY_API_KEY=
TWENTY_BASE_URL=
TWENTY_API_KEY=
TWENTY_BASIC_USER=
TWENTY_BASIC_PASSWORD=
LOG_MCP_PUBLIC_URL=
LOG_MCP_OWNER_USER_ID=

# ── CaptchaKraken (captcha solver) ───────────────────────────────────────
# https://github.com/CaptchaKraken/CaptchaKraken — npm `captchakraken`.
# Hosted API: put your ck_live_… key here. The endpoint is the hosted one.
# Alternative: `npx -y captchakraken-mcp` → sign_in → create_api_key writes
# ~/.captchakraken/credentials, which the solver reads when these are unset.
CAPTCHA_KRAKEN_API_KEY=
VLLM_BASE_URL=https://api.captchakraken.com/v1
# Optional knobs (defaults are right for the hosted API):
# CAPTCHA_HUMANIZATION=mouse        # mouse | mobile | none
# CAPTCHA_KRAKEN_AUTOSTART=0        # never start a local vLLM server
# CAPTCHA_REPORT_OUTCOME=1          # tell the hosted API if the solve stuck
# CAPTCHA_DEBUG=0

# ── 2Captcha ─────────────────────────────────────────────────────────────
# One key for both: the captcha fallback (reCAPTCHA token, Arkose) and the
# residential proxy API (https://2captcha.com/proxy/api). TWOCAPTCHA_API_KEY is
# read too, for shells that reject a name starting with a digit.
2CAPTCHA_API_KEY=
# The residential proxy password: 2Captcha dashboard → Proxy → your sub-account.
# It is not in the API, and `log proxy assign` needs it.
2CAPTCHA_PROXY_PASSWORD=
# Byteful (https://documentation.byteful.com): dashboard → API keys. Residential
# proxies through `log proxy assign --vendor byteful`; static IPs via `log proxy static`.
BYTEFUL_PUBLIC_KEY=
BYTEFUL_PRIVATE_KEY=

# accounts from ~/.logCli/localAccounts.json only (log localAccount pull copies Twenty's in); unset: local rows first, then Twenty
LOG_ACCOUNTS=local

# Memelord (docs/extensions/memelord.md): a key from https://www.memelord.com/settings/developer, starts with mlord_live_
MEMELORD_API_KEY=

# AssemblyAI, for log transcribe: every voice note on X and Discord transcribed into the conversation store (docs/voiceNotes.md)
ASSEMBLYAI_API_KEY=

# Fish Audio (docs/extensions/fishAudio.md): matt's cloned voice for the voice notes he asks for, a key from https://fish.audio/app/api-keys
FISH_API_KEY=

# Inworld (docs/extensions/inworld.md): the default voice provider for matt's cloned voice, the Base64 key from the Inworld portal
INWORLD_API_KEY=

# which voice provider says matt's voice notes: inworld (the default) or fishAudio
LOG_VOICE_PROVIDER=

# the accent matt's cloned voice is made in (rules 145, 147), default Irish
LOG_VOICE_ACCENT=

# the language locale his clone is made in: en-IE by default, en-GB when Inworld refuses it (rule 145)
LOG_VOICE_LANGUAGE=

# how fast his clone talks, as Inworld speakingRate, default 1.15, 0.8 to 1.5 (rule 146)
LOG_VOICE_SPEED=
