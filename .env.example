# R2 / Cloudflare (server-side only — never VITE_* prefix these).
# Values live in .env.local (copied from C:\Users\0\.buzz\.env.local).
# Server code should use the same fallback pattern as ui-kit:
#   R2_BUCKET ?? R2_MEDIA_BUCKET
#   CLOUDFLARE_R2_API_TOKEN ?? CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_BUCKET=

# Onboarding video (public URL, safe to expose — e.g. an R2 public URL).
# Falls back to a VidStack demo asset when unset.
VITE_ONBOARDING_VIDEO_URL=

# Clerk React SPA: publishable key only. CLI writes apps/web/.env.local.
# Never prefix CLERK_SECRET_KEY with VITE_ or reference it in browser code.
VITE_CLERK_PUBLISHABLE_KEY=

# Feed transport: mock (default) or live. Live requires the unified API;
# it never substitutes demo records when the API fails or returns no items.
# Vite loads these from apps/web/.env.local.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
# Public Convex deployment URL. With VITE_API_MODE=live the dashboard talks to
# Convex directly (live queries, no Hono bridge). Unset = bridge transport.
VITE_CONVEX_URL=

# Private platform services: server-only, never prefix keys with VITE_.
REDDIT_API_URL=http://localhost:8001
FACEBOOK_API_URL=http://localhost:8000
TWITTER_API_URL=http://localhost:8002
REDDIT_API_KEY=
FB_API_KEY=
TWITTER_API_KEY=

# Configure a DEV deployment locally; do not commit deploy keys.
CONVEX_DEPLOYMENT=
CONVEX_URL=
