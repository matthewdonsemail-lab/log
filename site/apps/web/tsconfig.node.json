{
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "./node_modules/.tmp/tsconfigNode",
    "rootDir": "../../.."
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "../../../src/observability/console/helpers/projection.ts",
    "../../../src/observability/console/types.ts",
    "../../../src/console/web/helpers/guard.ts"
  ]
}
