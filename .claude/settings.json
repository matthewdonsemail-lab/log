{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/event.ts",
              "SessionStart"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47317/hooks/UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__log__.*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47317/hooks/PostToolUse",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__log__(discord|slack|instagram).*",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/chatNames.ts"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/hooks/liveLogs.ts"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47317/hooks/Stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
