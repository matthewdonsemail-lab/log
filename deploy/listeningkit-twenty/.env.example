# install.sh generates .env automatically. These names are documentation only.
TWENTY_IMAGE=twentycrm/twenty:v2.49.0
TWENTY_URL=https://your-ubuntu-vm.your-tailnet.ts.net
POSTGRES_PASSWORD=<generated>
ACCESS_TOKEN_SECRET=<generated>
LOGIN_TOKEN_SECRET=<generated>
REFRESH_TOKEN_SECRET=<generated>
FILE_TOKEN_SECRET=<generated>
ENCRYPTION_KEY=<generated>
APP_SECRET=<generated>
# Added by install-relay.sh after the first workspace exists.
TWENTY_API_KEY=<entered-privately>
NEWSLETTER_RELAY_TOKEN=<generated>
CLOUDFLARED_TOKEN=<generated-by-configure_cloudflare.py>
# Added by install-buzz-bridge.sh after the owner creates the dedicated Buzz identity.
BUZZ_RELAY_URL=https://your-community.communities.buzz.xyz
BUZZ_BRIDGE_CHANNEL_ID=<private-crm-sync-channel-uuid>
BUZZ_BRIDGE_PRIVATE_KEY=<stored-privately>
BUZZ_BRIDGE_AUTH_TAG=<owner-attestation-json-if-required>
BUZZ_BRIDGE_PUBKEY=<64-character-public-key>
BUZZ_BRIDGE_MENTION_LABEL=Twenty CRM Bridge
BUZZ_BRIDGE_STARTED_AT=<unix-seconds-at-install>
BUZZ_BRIDGE_TWENTY_API_KEY=<dedicated-twenty-api-key>
