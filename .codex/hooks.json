{
  "description": "log-cli's agent hooks, written from src/agentHooks/registry (bun run check:agentHooks --write).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/pageState.ts\" --host codex",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/storage.ts\" --host codex",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/engines.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/knowledge.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/inbox.ts\" --host codex",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/queue.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/useCases.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/xLive.ts\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/pageState.ts\" --host codex",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/storage.ts\" --host codex",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/engines.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/inbox.ts\" --host codex",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf --connect-timeout 0.2 --max-time 0.8 -X POST --data-binary @- http://127.0.0.1:47317/hook?host=codex || bun \"$(git rev-parse --show-toplevel)/scripts/hooks/useCases.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/queue.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/xLive.ts\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__log__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/inbox.ts\" --host codex",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__log__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/queue.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__log__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/xLive.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__log__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/pageState.ts\" --host codex",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__log__(discord|slack|instagram).*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/chatNames.ts\" --host codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/liveLogs.ts\" --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/scripts/hooks/pageState.ts\" --host codex",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
