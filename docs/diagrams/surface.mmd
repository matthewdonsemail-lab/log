%% How a call reaches log-cli. From a shell or over MCP, both run the same commands through `runCli`, write the same live log, and pass through the same hooks.
%% Written by `bun run docs:build` from the code (rule 56). Not edited by hand.
flowchart LR
  agent["Agent (Claude Code, Codex)"]
  matt["matt, in a terminal"]
  shell["Bash / PowerShell / Monitor"]
  mcp["MCP server log: 90 command tools + saved flows"]
  bin["bin/log.ts"]
  runCli["runCli: 47 commands (COMMANDS)"]
  live[("~/.logCli/mcp/day.log: the live log")]
  browser["The account's browser (one per day, rule 35)"]
  agent --> shell
  matt --> bin
  shell --> bin
  agent -->|mcp__log__tool| mcp
  bin --> runCli
  mcp -->|runToolCall| runCli
  runCli --> browser
  bin -->|cli:command lines| live
  mcp -->|tool lines| live
  live -.->|tail -f, under Monitor| agent
  pre0{{"PreToolUse: liveLogs.ts"}} -.->|before| shell
  post0{{"PostToolUse: pageState.ts"}} -.->|after| agent
  turn0{{"SessionStart: pageState.ts"}} -.-> agent
  turn1{{"UserPromptSubmit: pageState.ts"}} -.-> agent
  turn2{{"SessionStart: storage.ts"}} -.-> agent
  turn3{{"UserPromptSubmit: storage.ts"}} -.-> agent
  turn4{{"SessionStart: engines.ts"}} -.-> agent
  turn5{{"UserPromptSubmit: engines.ts"}} -.-> agent
  turn6{{"Stop: pageState.ts"}} -.-> agent
  browser -.->|each step's snapshot| post0
