{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install -g pnpm@10.5.2 && cd site && pnpm install --frozen-lockfile",
  "buildCommand": "cd site && node scripts/build-site.mjs",
  "outputDirectory": "site/apps/web/dist",
  "rewrites": [
    { "source": "/api/kit/subscribe", "destination": "https://listeningkit.com/api/kit/subscribe" },
    { "source": "/docs/:path+", "destination": "/docs/:path+.html" },
    { "source": "/((?!docs/|assets/|logos/).*)", "destination": "/index.html" }]
}
